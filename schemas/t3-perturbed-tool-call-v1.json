{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T3 optional perturbed three-body solver call",
  "type": "object",
  "required": ["provider_id", "input_hash", "lock_path"],
  "properties": {
    "provider_id": {"const": "scipy-dop853-perturbed-v1"},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lock_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
