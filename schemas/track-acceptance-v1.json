{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/auditable-scientist/track-acceptance-v1.json",
  "title": "Auditable Scientist bounded track acceptance package",
  "type": "object",
  "additionalProperties": false,
  "required": ["track", "status", "evaluator", "negative_case", "evidence_boundaries", "execution", "checks"],
  "properties": {
    "track": {"type": "string", "enum": ["T2", "T3", "T3N", "T4", "T5"]},
    "status": {"const": "accepted-with-bounded-scope"},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "evaluator_id", "evidence_level", "input_hash", "passed", "negative_case_passed", "evidence_files", "source_files", "blocked_gates", "result"],
      "properties": {
        "track_id": {"type": "string", "enum": ["T2", "T3", "T3N", "T4", "T5"]},
        "evaluator_id": {"type": "string", "minLength": 1},
        "evidence_level": {"type": "string", "enum": ["demo", "validated-reproduction", "real-data", "research-candidate"]},
        "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "passed": {"type": "boolean"},
        "negative_case_passed": {"type": "boolean"},
        "evidence_files": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "source_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "blocked_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "result": {"type": "object"}
      }
    },
    "negative_case": {"type": "object"},
    "evidence_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demo", "validated_reproduction", "real_data", "research_candidate"],
      "properties": {
        "demo": {"const": true},
        "validated_reproduction": {"type": "boolean"},
        "real_data": {"const": false},
        "research_candidate": {"const": false}
      }
    },
    "execution": {"const": "offline"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "exit_code", "recorded_at", "input_version", "output_path"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "recorded_at": {"type": "string", "format": "date-time"},
          "input_version": {"type": "string", "minLength": 1},
          "output_path": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "provenance_status", "allowed_use"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "provenance_status": {"type": "string", "enum": ["verified", "unverified", "blocked"]},
        "allowed_use": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
